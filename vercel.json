{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/plan",
      "destination": "/plan/",
      "permanent": false
    },
    {
      "source": "/blueprints",
      "destination": "/blueprints/",
      "permanent": false
    },
    {
      "source": "/tests",
      "destination": "/tests/",
      "permanent": false
    },
    {
      "source": "/model",
      "destination": "/model/",
      "permanent": false
    },
    {
      "source": "/parts",
      "destination": "/parts/",
      "permanent": false
    },
    {
      "source": "/explore",
      "destination": "/explore/",
      "permanent": false
    },
    {
      "source": "/team",
      "destination": "/team/",
      "permanent": false
    },
    {
      "source": "/story",
      "destination": "/story/",
      "permanent": false
    },
    {
      "source": "/research",
      "destination": "/research/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/research/",
      "destination": "/research/index.html"
    },
    {
      "source": "/story/",
      "destination": "/story/index.html"
    },
    {
      "source": "/team/",
      "destination": "/team/index.html"
    },
    {
      "source": "/explore/",
      "destination": "/model/index.html"
    },
    {
      "source": "/plan/",
      "destination": "/plan/index.html"
    },
    {
      "source": "/blueprints/",
      "destination": "/blueprints/index.html"
    },
    {
      "source": "/tests/",
      "destination": "/tests/index.html"
    },
    {
      "source": "/model/",
      "destination": "/model/index.html"
    },
    {
      "source": "/parts/",
      "destination": "/parts/index.html"
    },
    {
      "source": "/((?!api/)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/3d/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/parts/glb/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
